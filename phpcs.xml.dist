<?xml version="1.0"?>
<ruleset name="Lonestar">
    <description>
        Lonestar parent theme coding-standard gate.

        This is a curated subset of WordPress-Extra, not the full standard:
        the codebase uses 4-space indentation and long array() syntax
        (documented in AGENTS.md), which conflicts with WordPress core's
        tab/whitespace formatting conventions. Rather than exclude dozens of
        individual formatting sniffs pulled in by WordPress-Extra, this
        ruleset opts in to the sniff groups that matter for a CI gate:
        security (escaping, nonces, sanitization, safe redirects, SQL),
        i18n, discouraged/deprecated PHP and WP functions, and dead code.
        Formatting/whitespace is intentionally out of scope here.
    </description>

    <!-- Scan the theme's own PHP; leave tooling, build output and vendored code alone. -->
    <file>.</file>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Compatibility: keep the runtime floor in sync with AGENTS.md (PHP 8.2+). -->
    <config name="testVersion" value="8.2-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Security: escaping, nonce/capability checks, sanitization, safe redirects, SQL. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.DB.SlowDBQuery"/>

    <!-- i18n: enforce the sole "lonestar" text domain (see AGENTS.md). -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="lonestar"/>
            </property>
        </properties>
    </rule>

    <!-- Discouraged/deprecated functions and obvious dead code. -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="Generic.PHP.DeprecatedFunctions"/>
    <rule ref="Squiz.PHP.Eval"/>
    <!--
        Squiz.PHP.NonExecutableCode.Unreachable is left out: it produces
        cascading false positives on this codebase's early-`continue`
        pattern (a `continue;` inside a nested `if` inside a `foreach`
        confuses the sniff into flagging everything after the *enclosing*
        function's earlier `return` as unreachable). Verified against
        inc/core/modules_catalog.php, where all 34 reported lines are
        genuinely reachable loop body code.
    -->
    <rule ref="Squiz.PHP.NonExecutableCode">
        <exclude name="Squiz.PHP.NonExecutableCode.Unreachable"/>
    </rule>

    <!-- Public symbol prefixing: lonestar_ / LONESTAR_ per AGENTS.md. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="lonestar"/>
                <element value="LONESTAR"/>
            </property>
        </properties>
        <!--
            Legacy, pre-lonestar_ compatibility symbols (TEMPLATE_PATH,
            modules_*(), etc.) are documented, intentional compatibility
            aliases (see AGENTS.md: "preserve documented compatibility
            aliases"). Excluding this sniff for the files that define them
            avoids flagging code that must not be renamed.
        -->
        <exclude-pattern>functions\.php</exclude-pattern>
        <exclude-pattern>inc/core/vite\.php</exclude-pattern>
        <exclude-pattern>inc/core/modules\.php</exclude-pattern>
        <exclude-pattern>inc/core/modules_admin\.php</exclude-pattern>
        <exclude-pattern>inc/core/modules_bootstrap\.php</exclude-pattern>
        <exclude-pattern>inc/core/modules_catalog\.php</exclude-pattern>
        <exclude-pattern>inc/core/modules_state\.php</exclude-pattern>
        <exclude-pattern>inc/core/blocks-acf\.php</exclude-pattern>
        <exclude-pattern>inc/core/blocks-acf-enqueue\.php</exclude-pattern>
        <exclude-pattern>inc/core/blocks-native\.php</exclude-pattern>
        <exclude-pattern>inc/helpers/helper\.debug\.php</exclude-pattern>
        <exclude-pattern>inc/helpers/helper\.printr\.php</exclude-pattern>
        <exclude-pattern>inc/shortcodes/shortcode\.reserved\.php</exclude-pattern>
        <exclude-pattern>inc/shortcodes/shortcode\.year\.php</exclude-pattern>
    </rule>
</ruleset>
