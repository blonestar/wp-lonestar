{
  "version": 3,
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "settings": {
    "appearanceTools": true,
    "color": {
      "link": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Background",
          "slug": "background",
          "color": "#f7f8fa"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#ffffff"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#1a1f29"
        },
        {
          "name": "Brand",
          "slug": "brand",
          "color": "#005f99"
        },
        {
          "name": "Brand Strong",
          "slug": "brand-strong",
          "color": "#004a78"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "System Sans",
          "slug": "body",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "name": "System Serif",
          "slug": "heading",
          "fontFamily": "Georgia, \"Times New Roman\", serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "14px",
          "fluid": {
            "min": "13px",
            "max": "14px"
          }
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "16px",
          "fluid": false
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "20px",
          "fluid": {
            "min": "17px",
            "max": "20px"
          }
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "24px",
          "fluid": {
            "min": "20px",
            "max": "24px"
          }
        }
      ],
      "fluid": true
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vh", "vw"]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|brand"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|brand-strong"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": ["page"]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "comments",
      "title": "Comments",
      "area": "uncategorized"
    }
  ]
}
